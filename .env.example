# ForgeLLM Phase 3 - Environment Configurations
# DO NOT ADD SECRETS HERE. Copy to .env and configure.

# Database
DATABASE_URL=postgresql://forgellm:password123@localhost:5432/forgellm

# Queue
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_ROOT=.forgellm/storage
DATASET_ROOT=.forgellm/datasets
MODEL_ROOT=.forgellm/models

# Logging & Timeouts
LOG_LEVEL=INFO
CELERY_TASK_TIMEOUT=86400
